    "@fontsource-variable/noto-serif-sc": "^5.2.10",
    "@fontsource-variable/noto-serif-sinhala": "^5.2.8",
    "@fontsource-variable/petrona": "^5.3.0",
    "@fontsource/abhaya-libre": "^5.3.0",
    "@fontsource/gemunu-libre": "^5.3.0",
    "@fontsource/maname": "^5.2.7",
    "@fontsource/zhi-mang-xing": "^5.3.0",
    "@giscus/vue": "^3.1.1",
    "@highlightjs/vue-plugin": "^2.1.0",
    "@markslides/markdown-it-mermaid": "^0.4.6",
    "@mdit/plugin-mathjax": "1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@unhead/vue": "^2.1.16",
    "@vitejs/plugin-legacy": "^6.0.2",
    "@vue/server-renderer": "^3.5.13",
    "@vueuse/core": "^13.1.0",
    "front-matter": "^4.0.2",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^9.2.0",
