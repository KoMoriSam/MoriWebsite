{
  "name": "KoMoriSam",
  "version": "1.24.0",
  "homepage": "https://komori.cc/",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-third-party-licenses.mjs --source",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/generate-routes.mjs && node scripts/generate-third-party-licenses.mjs --source",
    "build": "vite-ssg build && node scripts/generate-pagefind-index.mjs",
    "postbuild": "node scripts/generate-third-party-licenses.mjs --dist",
    "deploy": "gh-pages -d dist -r https://github.com/KoMoriSam/MoriWebsite.git",
    "preview": "vite preview --host 0.0.0.0",
    "push": "git push origin main:cl-pages --force",
    "api-worker": "wrangler deploy --config wrangler.api.jsonc --keep-vars"
  },
  "dependencies": {
