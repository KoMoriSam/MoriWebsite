{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mori-auth",
  "main": "./workers/auth/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "auth.komori.cc", "custom_domain": true }],
  "d1_databases": [{
    "binding": "AUTH_DB",
    "database_name": "mori-auth",
    "database_id": "d54a8503-a7ca-4643-8149-67fdb945eb44",
    "migrations_dir": "./migrations/auth"
  }],
  "ratelimits": [{ "name": "AUTH_START_LIMIT", "namespace_id": "1103", "simple": { "limit": 30, "period": 60 } }],
  "triggers": { "crons": ["17 3 * * *"] }
}
